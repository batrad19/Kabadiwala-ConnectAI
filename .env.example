# Kabadiwala Connect AI — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://kabadiwala:password@localhost:5432/kabadiwala_db

# ─── Authentication ──────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-minimum-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=../storage/uploads
ML_MODELS_DIR=../ml/saved_models
MAX_FILE_SIZE=10485760

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ─── ML Settings ─────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.70
UNCERTAINTY_THRESHOLD=0.45
ACTIVE_MODEL=efficientnet

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Kabadiwala Connect AI
